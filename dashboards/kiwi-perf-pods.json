  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": false,
          "text": "${DS_PROMETHEUS}",
          "value": "${DS_PROMETHEUS}"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "textbox",
        "query": "kiwi",
        "hide": 0,
        "current": {
          "selected": false,
          "text": "kiwi",
          "value": "kiwi"
        },
        "options": [
          {
            "selected": true,
            "text": "kiwi",
            "value": "kiwi"
          }
        ]
      },
      {
        "name": "pod",
        "label": "Pod (regex)",
        "type": "textbox",
        "query": "kiwi-perf.*",
        "hide": 0,
        "current": {
          "selected": false,
          "text": "kiwi-perf.*",
          "value": "kiwi-perf.*"
        },
        "options": [
          {
            "selected": true,
            "text": "kiwi-perf.*",
            "value": "kiwi-perf.*"
          }
        ]
      },
      {
        "name": "node",
        "label": "Nodo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(node_uname_info, nodename)",
          "refId": "node"
        },
        "definition": "label_values(node_uname_info, nodename)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "asic-x86-.*",
        "current": {
          "selected": true,
          "text": [
            "asic-x86-01",
            "asic-x86-02"
          ],
          "value": [
            "asic-x86-01",
            "asic-x86-02"
          ]
        },
        "options": [],
        "regex": "",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "time": {
