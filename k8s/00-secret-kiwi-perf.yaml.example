# Plantilla SIN valores reales. No aplicar tal cual: scripts/seed-secrets.sh crea
# estos secrets con `kubectl create secret` (valores aleatorios y de tcms.conf).
apiVersion: v1
kind: Secret
metadata:
  name: kiwi-perf-credentials
  namespace: kiwi
  labels:
    app.kubernetes.io/part-of: kiwi-perf
type: Opaque
stringData:
  secret_key: "<CHANGEME>"
  mariadb-root-password: "<CHANGEME>"
  mariadb-username: "kiwi"
  mariadb-password: "<CHANGEME>"
---
apiVersion: v1
kind: Secret
metadata:
  name: k6-perf-credentials
  namespace: kiwi
  labels:
    app.kubernetes.io/part-of: kiwi-perf
type: Opaque
stringData:
  makise-username: "<CHANGEME>"
  makise-password: "<CHANGEME>"
  perf-user-password: "<CHANGEME>"
